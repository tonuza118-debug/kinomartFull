# Copy this to .env for local dev, or set these as environment variables
# in the Render dashboard for production. NEVER commit a real .env file.

# --- Core ---
DJANGO_DEBUG=True
SECRET_KEY=change-me-generate-a-real-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# --- CORS / CSRF (comma-separated, no trailing slashes) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_ALL_ORIGINS=False
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000

# --- Database (Neon Postgres) ---
# Leave unset locally to use sqlite. In production, set to your Neon connection
# string, e.g. postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# --- Media storage (Cloudflare R2) ---
USE_R2_STORAGE=False
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# Optional — your R2 public bucket domain or custom CDN domain for serving images
R2_PUBLIC_DOMAIN=

# --- SSLCommerz payments (leave as sandbox defaults until you have a live store) ---
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWORD=qwerty
SSLCOMMERZ_SANDBOX=True

# --- HTTPS ---
SECURE_SSL_REDIRECT=True
