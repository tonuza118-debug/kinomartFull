# Copy this to .env for local dev, or set these as environment variables
# in the Render dashboard for production. NEVER commit a real .env file.

# --- Core ---
DJANGO_DEBUG=True
SECRET_KEY=change-me-generate-a-real-random-value
DJANGO_ALLOWED_HOSTS=*
BACKEND_URL=
FRONTEND_URL=

# --- CORS / CSRF ---
# Fully open — fine here since the API auth is JWT bearer tokens (no cookies,
# CORS_ALLOW_CREDENTIALS is off), so cross-origin requests can't ride on a
# logged-in session. CSRF_TRUSTED_ORIGINS only affects cookie/session flows
# (mainly Django admin) and can't be a true wildcard, so it's scoped to your
# deploy platforms instead.
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_ALL_ORIGINS=True
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,https://*.onrender.com

# --- Database (Neon Postgres) — required, no sqlite fallback ---
# postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# --- Media storage (Cloudflare R2) — required, no local-disk fallback ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# Optional — your R2 public bucket domain or custom CDN domain for serving images
# e.g. the "Public Development URL" from the R2 bucket settings, or a custom domain
R2_PUBLIC_DOMAIN=pub-eefe28cff0ad4012b861527210a14b36.r2.dev

# --- SSLCommerz payments (leave as sandbox defaults until you have a live store) ---
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWORD=qwerty
SSLCOMMERZ_SANDBOX=True

# --- HTTPS ---
SECURE_SSL_REDIRECT=True
