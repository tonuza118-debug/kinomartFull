# Copy to .env for local dev: cp .env.example .env
# In production, set these as real environment variables on the host/platform
# instead (Render/Railway/Fly/Heroku/systemd EnvironmentFile/etc.) — don't
# ship a .env file to production.

# --- Core ---
# Must be False in production. Debug=True leaks stack traces, source code,
# and settings to anyone who can trigger a 500.
DJANGO_DEBUG=True

# Generate a real one for production, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Keep it out of source control.
DJANGO_SECRET_KEY=django-insecure-kino-mart-dev-key-change-in-production

# Comma-separated. Must list your real domain(s) in production
# (e.g. api.kinomart.com). A leading dot matches all subdomains.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- CORS (which frontend origins may call this API) ---
# Comma-separated exact origins, e.g. https://kinomart.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# Comma-separated regexes, only if you need wildcard-subdomain origins
# (e.g. per-branch preview deploys). Leave blank otherwise.
CORS_ALLOWED_ORIGIN_REGEXES=
# Leave False. True disables CORS_ALLOWED_ORIGINS entirely and allows any
# origin to call the API — only ever useful for a throwaway demo.
CORS_ALLOW_ALL_ORIGINS=False

# --- CSRF (used by the Django admin's session-cookie login) ---
# Comma-separated, must include scheme, e.g. https://kinomart.com
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000

# --- Database ---
# Leave unset to use the local sqlite file (dev only — not safe for a real
# deployment: no concurrent writers, lost if the disk/container resets).
# Set to a real Postgres URL in production:
#   DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=

# --- HTTPS hardening (only applied when DJANGO_DEBUG=False) ---
# Redirect http -> https. Turn off only if TLS is terminated somewhere Django
# can't see the redirect happening for (rare).
DJANGO_SECURE_SSL_REDIRECT=True
# How long browsers should remember to only use HTTPS for this host, once
# HSTS is confirmed working end-to-end. Starts conservative at 30 days.
DJANGO_SECURE_HSTS_SECONDS=2592000
