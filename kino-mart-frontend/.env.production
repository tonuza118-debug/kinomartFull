# Loaded automatically by `npm run build` / `vite build --mode production`.
# These values get baked into the built JS bundle at build time (Vite env
# vars are public, not secrets) — rebuild whenever the backend URL changes.

# Point this at your deployed Django origin (no trailing slash).
VITE_API_BASE_URL=https://your-backend-domain.example.com

# Only set this if media is served from a different host than the API
# (e.g. a CDN/S3 bucket in front of Django's MEDIA_URL). Leave blank to
# fall back to VITE_API_BASE_URL.
VITE_MEDIA_ORIGIN=
