# Leave blank in dev — Vite's proxy (see vite.config.js) forwards /api and /media
# to VITE_API_PROXY_TARGET (defaults to http://127.0.0.1:8000).
VITE_API_BASE_URL=

# In production, point this at your deployed Django origin, e.g.:
# VITE_API_BASE_URL=https://api.kinomart.com

# Only needed if media is served from a different host than the API
# (e.g. a CDN or S3 bucket in front of Django's MEDIA_URL).
VITE_MEDIA_ORIGIN=

# Dev-only: which backend the Vite proxy forwards /api and /media to.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
